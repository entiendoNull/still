{
  "expo": {
    "name": "Still",
    "slug": "focus-session",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/still-icon.png",
    "scheme": "stillfocus",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/still.icon",
      "bundleIdentifier": "dev.entiendonull.stillfocus",
      "supportsTablet": false,
      "appleTeamId": "KU5LVFW47D"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.entiendonull.stillfocus"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101A18",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-app-intents",
      [
        "expo-dev-client",
        {
          "showMenuAtLaunch": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": ["app-intents"]
      }
    }
  }
}
